# Copy to /opt/image-studio/.env on the VPS. Never commit real keys.

OPENWEBUI_URL=https://micropigeon.com
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8091
STUDIO_PUBLIC_URL=https://image.micropigeon.com
STUDIO_DATA_DIR=/data
# Random 32+ chars. Persist on the Studio volume. Not WEBUI_SECRET_KEY.
STUDIO_SECRET_KEY=
# 1 on VPS behind Caddy HTTPS. Leave empty for local http://127.0.0.1:8091
STUDIO_COOKIE_SECURE=

STUDIO_OPENAI_API_KEY=
STUDIO_GEMINI_API_KEY=
STUDIO_XAI_API_KEY=
STUDIO_OPENROUTER_API_KEY=
